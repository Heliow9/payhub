{
  "name": "payhub",
  "private": true,
  "version": "0.3.4",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @payhub/api & npm run dev --workspace @payhub/dashboard",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @payhub/api",
    "bootstrap:master": "npm run bootstrap:master --workspace @payhub/api",
    "start:api": "npm run start --workspace @payhub/api",
    "start:worker": "npm run start:worker --workspace @payhub/api"
  },
  "engines": {
    "node": ">=22"
  }
}
